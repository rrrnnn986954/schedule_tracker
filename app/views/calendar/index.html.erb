<h1><%= @date.strftime("%Y年%-m月") %></h1>
<nav>
  <%= link_to "前月", calendar_index_path(month: (@date - 1.month).strftime("%Y-%m-01")) %> |
  <%= link_to "翌月", calendar_index_path(month: (@date + 1.month).strftime("%Y-%m-01")) %>
</nav>

<table class="month-grid" style="border-collapse:collapse; width:100%; margin-top:12px;">
  <thead>
    <tr>
      <% %w(日 月 火 水 木 金 土).each do |w| %>
        <th style="padding:6px; border-bottom:1px solid #eee;"><%= w %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% first = @date.beginning_of_week(:sunday) %>
    <% last  = @date.end_of_month.end_of_week(:sunday) %>
    <% (first..last).to_a.in_groups_of(7).each do |week| %>
      <tr>
        <% week.each do |day| %>
          <td style="padding:10px; border-bottom:1px solid #f3f4f6; text-align:right; vertical-align:top; <%= 'color:#9ca3af;' if day.month != @date.month %>">
            <%= link_to day.day, calendar_day_path(date: day.strftime("%Y-%m-%d")), style: "text-decoration:none;" %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
