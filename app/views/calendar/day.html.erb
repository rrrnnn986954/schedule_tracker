<!-- app/views/calendar/day.html.erb -->
<main style="--minute-h: 1.1px; padding: 12px;">

  <!-- 日付タイトル -->
  <header style="text-align:center; margin-bottom:16px;">
    <h2 style="font-size:1.3em; font-weight:700;">
      <%= @date.strftime("%Y年%-m月%-d日") %>
    </h2>
    <%= link_to "← 戻る", calendar_index_path(month: @date.beginning_of_month), class: "btn-primary", style: "margin-top:8px; display:inline-block;" %>
  </header>

  <h2>スケジュール追加</h2>
    <%= render "planned_events/form", date: @date, categories: @categories %>
    <hr style="margin: 20px 0;">
  <h2>1日の予定と実績</h2>

  <% if @planned.present? %>
    <ul style="padding-left: 1rem;">
      <% @planned.each do |ev| %>
        <li style="margin:6px 0;">
          <%= ev.start_at.strftime("%H:%M") %> - <%= ev.end_at.strftime("%H:%M") %>
          <%= ev.category.name %>
          <%= link_to "編集", edit_planned_event_path(ev), class: "btn-primary", style: "margin-left:8px;padding:4px 8px;font-size:12px;" %>
          <%= link_to "削除", planned_event_path(ev),
                data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                class: "btn-primary",
                style: "margin-left:6px;padding:4px 8px;font-size:12px;" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>この日の予定はありません。</p>
  <% end %>

  <!-- タイムライン見出し -->
  <div class="timeline-head">
    <div></div>
    <div>計画</div>
    <div>実績</div>
  </div>

  <!-- タイムライン -->
  <div class="timeline-vertical" style="margin-bottom:32px;">
    <% base = @date.beginning_of_day %>
    <% total_minutes = 24 * 60 %>

    <!-- 時間ラベル列 -->
    <div class="timeline-hours">
      <% (0..24).each do |h| %>
        <% top_min = h * 60 %>
        <div class="timeline-hour-mark" style="top: calc(var(--minute-h) * <%= top_min %>);">
          <%= "%02d:00" % h %>
        </div>
      <% end %>
    </div>

    <!-- 計画カラム -->
    <div class="timeline-col">
      <% @timeline_planned.each do |b| %>
        <% start_min = [((b[:start] - base) / 60).floor, 0].max %>
        <% end_min   = [((b[:end]   - base) / 60).ceil, total_minutes].min %>
        <% dur_min   = [end_min - start_min, 0].max %>
        <% hex = color_hex(b[:category]) %>
        <div class="event-block"
             style="top: calc(var(--minute-h) * <%= start_min %>);
                    height: calc(var(--minute-h) * <%= dur_min %>);
                    background: <%= hex %>;">
          <span><%= b[:category].name %></span>
          <span>· <%= b[:start].strftime("%H:%M") %>–<%= b[:end].strftime("%H:%M") %></span>
        </div>
      <% end %>
    </div>

    <!-- 実績カラム -->
    <div class="timeline-col">
      <% @timeline_tracked.each do |b| %>
        <% start_min = [((b[:start] - base) / 60).floor, 0].max %>
        <% end_min   = [((b[:end]   - base) / 60).ceil, total_minutes].min %>
        <% dur_min   = [end_min - start_min, 0].max %>
        <% hex = color_hex(b[:category]) %>
        <div class="event-block"
             style="top: calc(var(--minute-h) * <%= start_min %>);
                    height: calc(var(--minute-h) * <%= dur_min %>);
                    background: <%= hex %>;">
          <span><%= b[:category].name %></span>
          <span>· <%= b[:start].strftime("%H:%M") %>–<%= b[:end].strftime("%H:%M") %></span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 円グラフ（24時間基準） -->
  <section>
    <h3 style="margin-bottom:8px; text-align:center;">計画 vs 実績（24時間基準）</h3>

    <div class="charts-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start;">
      <div>
        <h4 style="text-align:center;">計画</h4>
        <canvas id="piePlanned" height="180"></canvas>
      </div>
      <div>
        <h4 style="text-align:center;">実績</h4>
        <canvas id="pieTracked" height="180"></canvas>
      </div>
    </div>
  </section>

</main>

<!-- Chart.js スクリプト -->
<script type="module">
  import Chart from "chart.js/auto"

  const plannedLabels = <%= raw @planned_chart.keys.to_json %>;
  const plannedData   = <%= raw @planned_chart.values.to_json %>;
  const trackedLabels = <%= raw @tracked_chart.keys.to_json %>;
  const trackedData   = <%= raw @tracked_chart.values.to_json %>;
  const CATEGORY_COLORS = <%= raw current_user.categories.map { |c| [c.name, color_hex(c)] }.to_h.to_json %>;

  const TOTAL_MINUTES = 1440;
  function normalizeToDay(labels, data) {
    const total = data.reduce((a,b)=>a+b,0);
    const remain = Math.max(0, TOTAL_MINUTES - total);
    const newLabels = [...labels];
    const newData   = [...data];
    const newColors = labels.map(name => CATEGORY_COLORS[name] || "#9ca3af");
    if (remain > 0) {
      newLabels.push("未使用時間");
      newData.push(remain);
      newColors.push("#e5e7eb");
    }
    return { labels: newLabels, data: newData, colors: newColors };
  }

  function drawPie(canvasId, labels, data) {
    const ctx = document.getElementById(canvasId);
    const norm = normalizeToDay(labels, data);
    new Chart(ctx, {
      type: "doughnut",
      data: {
        labels: norm.labels,
        datasets: [{
          data: norm.data,
          backgroundColor: norm.colors
        }]
      },
      options: {
        plugins: {
          legend: { position: "bottom" },
          tooltip: {
            callbacks: {
              label: (ctx) => {
                const val = ctx.raw;
                const pct = (val / TOTAL_MINUTES * 100).toFixed(1);
                const h = Math.floor(val / 60);
                const m = val % 60;
                return `${ctx.label}: ${h}時間${m}分 (${pct}%)`;
              }
            }
          }
        }
      }
    });
  }

  if (plannedLabels.length > 0) drawPie("piePlanned", plannedLabels, plannedData);
  if (trackedLabels.length > 0) drawPie("pieTracked", trackedLabels, trackedData);
</script>
