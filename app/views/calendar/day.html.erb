<h2><%= @date.strftime("%Y年%-m月%-d日") %></h2>

<section>
  <h3>その日の計画</h3>
  <ul>
    <% @planned.each do |p| %>
      <li>
        <%= p.start_at.strftime("%H:%M") %> - <%= p.end_at.strftime("%H:%M") %>
        / <%= p.category.name %>
      </li>
    <% end %>
    <% if @planned.blank? %>
      <li>まだ計画がありません</li>
    <% end %>
  </ul>
</section>

<hr>

<section>
  <h3>実績（Tracked）</h3>
  <ul>
    <% if @tracked.present? %>
      <% @tracked.each do |t| %>
        <li>
          <%= t.started_at.strftime("%H:%M") %> - <%= t.ended_at.strftime("%H:%M") %>
          / <%= t.category.name %>
        </li>
      <% end %>
    <% else %>
      <li>当日の実績はありません</li>
    <% end %>
  </ul>
</section>


<hr>

<section>
  <h3>スケジュール追加</h3>
  <%= render "planned_events/form", date: @date, categories: @categories %>
</section>

<p style="margin-top:16px;"><%= link_to "月カレンダーへ戻る", calendar_index_path(month: @date.beginning_of_month.strftime("%Y-%m-01")) %></p>
