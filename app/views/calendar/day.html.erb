<h2><%= @date.strftime("%Y年%-m月%-d日") %></h2>

<section>
  <h3>スケジュール追加</h3>
  <%= render "planned_events/form", date: @date, categories: @categories %>
</section>

<p style="margin-top:16px;"><%= link_to "月カレンダーへ戻る", calendar_index_path(month: @date.beginning_of_month.strftime("%Y-%m-01")) %></p>



<hr>
<h3><%= @date.strftime("%Y年%-m月%-d日") %></h3>

<!-- 高さスケール：--minute-h を好みで（1.0〜1.4px あたり） -->
<div style="--minute-h: 1.1px;">
  <div class="timeline-head">
    <div></div>
    <div>計画</div>
    <div>実績</div>
  </div>

  <div class="timeline-vertical">
    <% base = @date.beginning_of_day %>
    <% total_minutes = 24 * 60 %>

    <!-- 時間ラベル列 -->
    <div class="timeline-hours">
      <% (0..24).each do |h| %>
        <% top_min = h * 60 %>
        <div class="timeline-hour-mark"
             style="top: calc(var(--minute-h) * <%= top_min %>);">
          <%= "%02d:00" % h %>
        </div>
      <% end %>
    </div>

    <!-- 計画カラム -->
    <div class="timeline-col">
      <% @timeline_planned.each do |b| %>
        <% start_min = [((b[:start] - base) / 60).floor, 0].max %>
        <% end_min   = [((b[:end]   - base) / 60).ceil,  total_minutes].min %>
        <% dur_min   = [end_min - start_min, 0].max %>
        <% hex = color_hex(b[:category]) %>
        <div class="event-block"
             style="top: calc(var(--minute-h) * <%= start_min %>);
                    height: calc(var(--minute-h) * <%= dur_min %>);
                    background: <%= hex %>;">
          <span><%= b[:category].name %></span>
          <span>· <%= b[:start].strftime("%H:%M") %>–<%= b[:end].strftime("%H:%M") %></span>
        </div>
      <% end %>
    </div>

    <!-- 実績カラム -->
    <div class="timeline-col">
      <% @timeline_tracked.each do |b| %>
        <% start_min = [((b[:start] - base) / 60).floor, 0].max %>
        <% end_min   = [((b[:end]   - base) / 60).ceil,  total_minutes].min %>
        <% dur_min   = [end_min - start_min, 0].max %>
        <% hex = color_hex(b[:category]) %>
        <div class="event-block"
             style="top: calc(var(--minute-h) * <%= start_min %>);
                    height: calc(var(--minute-h) * <%= dur_min %>);
                    background: <%= hex %>;">
          <span><%= b[:category].name %></span>
          <span>· <%= b[:start].strftime("%H:%M") %>–<%= b[:end].strftime("%H:%M") %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>



<hr>
<h3>計画 vs 実績（円グラフ）</h3>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;">
  <div>
    <h4>計画</h4>
    <canvas id="piePlanned" height="180"></canvas>
  </div>
  <div>
    <h4>実績</h4>
    <canvas id="pieTracked" height="180"></canvas>
  </div>
</div>

<script type="module">
  import Chart from "chart.js/auto"

  // Ruby側からデータを注入
  const plannedLabels = <%= raw @planned_chart.keys.to_json %>;
  const plannedData   = <%= raw @planned_chart.values.to_json %>;
  const trackedLabels = <%= raw @tracked_chart.keys.to_json %>;
  const trackedData   = <%= raw @tracked_chart.values.to_json %>;

  // カテゴリー名→HEX色のマッピング
  const CATEGORY_COLORS = <%= raw current_user.categories
                                  .map { |c| [c.name, color_hex(c)] }
                                  .to_h.to_json %>;

  const toColors = (labels) => labels.map(name => CATEGORY_COLORS[name] || "#9ca3af");

  // 計画グラフ
  const elPlanned = document.getElementById("piePlanned");
  if (plannedLabels.length > 0) {
    new Chart(elPlanned, {
      type: "pie",
      data: {
        labels: plannedLabels,
        datasets: [{
          data: plannedData,
          backgroundColor: toColors(plannedLabels)
        }]
      },
      options: {
        plugins: {
          legend: { position: "bottom" },
          title: { display: false }
        }
      }
    });
  } else {
    elPlanned.insertAdjacentHTML("afterend", "<p>計画のデータがありません</p>");
  }

  // 実績グラフ
  const elTracked = document.getElementById("pieTracked");
  if (trackedLabels.length > 0) {
    new Chart(elTracked, {
      type: "pie",
      data: {
        labels: trackedLabels,
        datasets: [{
          data: trackedData,
          backgroundColor: toColors(trackedLabels)
        }]
      },
      options: {
        plugins: {
          legend: { position: "bottom" },
          title: { display: false }
        }
      }
    });
  } else {
    elTracked.insertAdjacentHTML("afterend", "<p>実績のデータがありません</p>");
  }
</script>
